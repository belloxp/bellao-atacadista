{
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/usuarios", "destination": "https://bellao-atacadista-production.up.railway.app/usuarios" },
    { "source": "/usuarios/:path*", "destination": "https://bellao-atacadista-production.up.railway.app/usuarios/:path*" },
    { "source": "/produtos", "destination": "https://bellao-atacadista-production.up.railway.app/produtos" },
    { "source": "/produtos/:path*", "destination": "https://bellao-atacadista-production.up.railway.app/produtos/:path*" },
    { "source": "/compra", "destination": "https://bellao-atacadista-production.up.railway.app/compra" },
    { "source": "/compras", "destination": "https://bellao-atacadista-production.up.railway.app/compras" },
    { "source": "/relatorio/:path*", "destination": "https://bellao-atacadista-production.up.railway.app/relatorio/:path*" }
  ]
}
